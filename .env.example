# ========================================================
# CivicResolve Environment Configuration Template
# Copy this file to .env and configure your production values
# Never commit real secrets or production .env files to Git
# ========================================================

# Runtime Environment (development | production)
NODE_ENV=production

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:3000

# SQLite Database Location (Absolute or project-relative persistent path)
# In Docker, mount a persistent volume: e.g. file:/data/civicresolve.db
DATABASE_URL=file:./local.db

# Cryptographic Session & JWT Secret (Mandatory in production, min 32 random chars)
# Generate with: openssl rand -base64 32
JWT_SECRET=
SESSION_SECRET=

# Storage Configuration
# Driver options: local (default)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# Initial Administrator Account (Optional - for server/seed-admin.ts)
ADMIN_EMAIL=admin@civicresolve.internal
ADMIN_PASSWORD=
ADMIN_NAME=System Administrator
